# Use the port allocated by your hosting panel (usually set this in the panel).
# If the panel does not provide PORT or SERVER_PORT, put its allocated port here.
PORT=

# Login secret: replace with your own random string (at least 16 characters).
# TERMINAL_TOKEN=replace-this-with-a-long-random-secret

# Defaults are suitable for hosted containers; these are optional overrides.
# HOST=0.0.0.0
# ALLOW_PRIVATE_ONLY=0
# SHELL_BIN=/bin/bash
# COOKIE_SECURE=1
