# Use the port allocated by your hosting panel (usually set this in the panel).
# If the panel does not provide PORT or SERVER_PORT, put its allocated port here.
PORT=

# Login secret: replace with your own random string (at least 16 characters).
# TERMINAL_TOKEN=replace-this-with-a-long-random-secret

# Defaults are suitable for hosted containers; these are optional overrides.
# HOST=0.0.0.0
# ALLOW_PRIVATE_ONLY=0
# SHELL_BIN=/bin/bash
# COOKIE_SECURE=1

# --- CLIProxyAPI gateway (mounted at /cpa) ---
# Public origin used only in the startup log; no trailing slash.
# CLIPROXYAPI_PUBLIC_URL=https://example.com

# Track the latest GitHub release by default. Pin to a tag, or skip checks.
# CLIPROXYAPI_VERSION=v8.0.80
# CLIPROXYAPI_SKIP_UPDATE=0

# Generated on first run and saved in $HOME/.ptygate/cliproxyapi/secrets.json.
# Set these to reuse your own secrets (keep them out of the repo!).
# CLIPROXYAPI_API_KEY=
# CLIPROXYAPI_MANAGEMENT_KEY=

# Loopback port for the child process. Default: pick a free port automatically.
# CLIPROXYAPI_PORT=8317

# Optional GitHub token to avoid API rate limits on release checks.
# GITHUB_TOKEN=
