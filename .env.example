# =============================================================================
# MANDATORY — set these in the hosting panel (keep them together)
# Values already set by the panel always win over this file.
# =============================================================================

# The single public port allocated by your hosting panel.
# The server refuses to start without PORT, SERVER_PORT, or PTYGATE_PORT.
PORT=

# Password for the web terminal at /login (at least 16 characters).
# IMPORTANT: if this is unset, a random token is generated on EVERY restart
# and printed in the startup log. Set it to keep the same login after restarts.
# TERMINAL_TOKEN=replace-this-with-a-long-random-secret


# =============================================================================
# OPTIONAL — terminal settings
# =============================================================================

# Interface to listen on. Leave as 0.0.0.0 for the hosting panel's proxy.
# HOST=0.0.0.0

# Set to 1 to allow connections only from private IP ranges.
# Applies to ALL routes, including /healthz, /api/terminal/metrics, and /9router/*.
# ALLOW_PRIVATE_ONLY=0

# Shell used by the terminal.
# SHELL_BIN=/bin/bash

# Set to 1 when HTTPS is terminated by the hosting proxy.
# COOKIE_SECURE=1


# =============================================================================
# OPTIONAL — 9router gateway at /9router/ (installed automatically on start)
# =============================================================================

# Your public origin (no trailing slash). Used only in the startup log message
# that shows the API base URL, e.g. https://your-domain.example
# NINEROUTER_PUBLIC_URL=

# Follow npm's latest 9router release by default. Pin a tested version, or skip
# update checks to reuse the installed package without checking npm.
# NINEROUTER_VERSION=0.5.123
# NINEROUTER_SKIP_UPDATE=0

# Loopback port for the 9router child process. Default: pick a free port
# automatically. Must be between 1024 and 65535 if set.
# NINEROUTER_PORT=8317

# Reuse an existing 9router API key (it must already exist in 9router's
# database). When unset, ptygate creates one on first start and saves it in
# $HOME/.ptygate/ninerouter/secrets.json.
# NINEROUTER_API_KEY=

# Dashboard password used on first startup. When unset, a private password is
# generated and printed in the startup log.
# NINEROUTER_INITIAL_PASSWORD=
