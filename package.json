{
  "name": "web-terminal",
  "version": "0.1.0",
  "description": "Browser terminal backed by a real PTY, for testing remote command execution over HTTP",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lan": "LAN=1 node server.js",
    "console": "node server.js --console",
    "lan:console": "LAN=1 ALLOW_PRIVATE_ONLY=0 PORT=${SERVER_PORT:-8080} node server.js --console",
    "dev": "node --watch server.js",
    "dev:lan": "LAN=1 node --watch server.js",
    "check": "for f in server.js src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "sh scripts/test-contract.sh",
    "contract:sync": "sh scripts/sync-contract.sh",
    "contract:check": "sh scripts/sync-contract.sh --check",
    "env:report": "sh scripts/env-report.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  }
}
