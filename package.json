{
  "name": "ptygate",
  "version": "0.1.0",
  "private": true,
  "description": "Guarded web terminal gateway: token login, IP allowlist, and resumable PTY sessions over WebSocket",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:lan": "node server.js --host 0.0.0.0",
    "start:console": "node server.js --console",
    "start:container": "node server.js --host 0.0.0.0 --ip-mode any --console",
    "dev": "node --watch server.js",
    "dev:lan": "node --watch server.js --host 0.0.0.0",
    "help": "node server.js --help",
    "check": "for f in server.js src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "sh scripts/test-contract.sh",
    "test:list": "python3 contract/tests/run_all.py --list",
    "contract:sync": "sh scripts/sync-contract.sh",
    "contract:check": "sh scripts/sync-contract.sh --check",
    "env:report": "sh scripts/env-report.sh",
    "lan": "npm run start:lan",
    "console": "npm run start:console",
    "lan:console": "npm run start:container"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  }
}
